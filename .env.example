# Modulo "Valuta la tua casa": collegamento a Google Sheet.
# Istruzioni complete in docs/google-sheet.md.
# Senza queste due variabili il modulo funziona solo in sviluppo (invio simulato).
GOOGLE_SCRIPT_URL=
GGM_FORM_TOKEN=
